<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:E_Commerce.ViewModels"
             x:Class="E_Commerce.Views.AdminDashboardPage"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- Custom Header -->
        <Grid Grid.Row="0" Padding="20,16" ColumnDefinitions="Auto, *, Auto" VerticalOptions="Start">
            <Button Text="←" 
                    FontSize="20"
                    WidthRequest="44" 
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    BackgroundColor="{StaticResource SecondaryBackground}"
                    TextColor="{StaticResource TextPrimary}"
                    Command="{Binding GoBackCommand}" />
            
            <Label Grid.Column="1" Text="Admin Dashboard" FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
            
            <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
        </Grid>

        <!-- Menu Items -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="20" Spacing="20">

                <!-- Manage Products -->
                <Frame CornerRadius="16" Padding="0" HasShadow="True"
                       BackgroundColor="{StaticResource CardBackground}" BorderColor="Transparent">
                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20">
                        <Label Text="📦" FontSize="32" VerticalOptions="Center" Margin="0,0,16,0" />
                        <StackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Manage Products" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Create, Edit, or Remove Items" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        </StackLayout>
                        <Label Grid.Column="2" Text="→" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToProductsCommand}" />
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- Manage Categories -->
                <Frame CornerRadius="16" Padding="0" HasShadow="True"
                       BackgroundColor="{StaticResource CardBackground}" BorderColor="Transparent">
                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20">
                        <Label Text="📂" FontSize="32" VerticalOptions="Center" Margin="0,0,16,0" />
                        <StackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Manage Categories" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="View or Update Product Categories" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        </StackLayout>
                        <Label Grid.Column="2" Text="→" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToCategoriesCommand}" />
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- Manage Orders -->
                <Frame CornerRadius="16" Padding="0" HasShadow="True"
                       BackgroundColor="{StaticResource CardBackground}" BorderColor="Transparent">
                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20">
                        <Label Text="🚚" FontSize="32" VerticalOptions="Center" Margin="0,0,16,0" />
                        <StackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Manage Orders" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="View and Update Customer Orders" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        </StackLayout>
                        <Label Grid.Column="2" Text="→" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToOrdersCommand}" />
                    </Frame.GestureRecognizers>
                </Frame>

            </StackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
