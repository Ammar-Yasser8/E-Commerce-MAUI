<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:E_Commerce.ViewModels"
             xmlns:models="clr-namespace:E_Commerce.Models.Api"
             x:Class="E_Commerce.Views.AdminProductsPage"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- Custom Header -->
        <Grid Grid.Row="0" Padding="20,16" ColumnDefinitions="Auto, *, Auto" VerticalOptions="Start">
            <Button Text="←" 
                    FontSize="20"
                    WidthRequest="44" 
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    BackgroundColor="{StaticResource SecondaryBackground}"
                    TextColor="{StaticResource TextPrimary}"
                    Command="{Binding GoBackCommand}" />
            
            <Label Grid.Column="1" Text="Products Manager" FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
            
            <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto">
            <!-- Search Bar -->
            <Frame Grid.Row="0" CornerRadius="16" HasShadow="False" BorderColor="{StaticResource Gray200}" 
                   Margin="20,0,20,10" Padding="16,0" HeightRequest="50" BackgroundColor="{StaticResource CardBackground}">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="🔍" FontSize="16" VerticalOptions="Center" Margin="0,0,10,0" />
                    <Entry Grid.Column="1"
                           Placeholder="Search products..."
                           PlaceholderColor="{StaticResource TextLight}"
                           TextColor="{StaticResource TextPrimary}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Text="{Binding SearchTerm}" />
                </Grid>
            </Frame>

            <!-- Products List -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding Products}" Margin="20,0"
                            RemainingItemsThreshold="2"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreProductsCommand}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProductToReverseDto">
                        <Frame CornerRadius="16" Padding="12" HasShadow="False"
                               BackgroundColor="{StaticResource CardBackground}" BorderColor="Transparent">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Frame CornerRadius="8" Padding="0" WidthRequest="50" HeightRequest="50"
                                       BackgroundColor="{StaticResource SecondaryBackground}">
                                    <Image Source="{Binding PictureUrl}" Aspect="AspectFill" />
                                </Frame>
                                
                                <StackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0">
                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" MaxLines="1" />
                                    <Label Text="{Binding Price, StringFormat='${0:F2}'}" FontSize="13" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                </StackLayout>

                                <Button Grid.Column="2" Text="🗑️" FontSize="16"
                                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                                        Padding="0" BackgroundColor="#FF3B30" TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminProductsViewModel}}, Path=DeleteProductCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminProductsViewModel}}, Path=EditProductCommand}"
                                                       CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Add Product Floating Button -->
            <Button Grid.Row="1" Text="➕" FontSize="20"
                    WidthRequest="56" HeightRequest="56" CornerRadius="28"
                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                    HorizontalOptions="End" VerticalOptions="End" Margin="0,0,24,24"
                    Command="{Binding CreateProductCommand}" />

            <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>

</ContentPage>
