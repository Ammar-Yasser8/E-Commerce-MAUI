<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:E_Commerce.ViewModels"
             x:Class="E_Commerce.Views.CheckoutPage"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- Custom Header -->
        <Grid Grid.Row="0" Padding="20,16" ColumnDefinitions="Auto, *, Auto" VerticalOptions="Start">
            <Button Text="←" 
                    FontSize="20"
                    WidthRequest="44" 
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    BackgroundColor="{StaticResource SecondaryBackground}"
                    TextColor="{StaticResource TextPrimary}"
                    Command="{Binding GoBackCommand}" />
            
            <Label Grid.Column="1" Text="Checkout" FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
            
            <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
        </Grid>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="20" Spacing="20">

                <!-- Order Summary -->
                <Label Text="Order Summary" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                
                <Frame CornerRadius="20" HasShadow="True" Padding="20"
                       BackgroundColor="{StaticResource CardBackground}" BorderColor="Transparent">
                    <StackLayout Spacing="12">
                        <!-- Subtotal -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Subtotal" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                   FontSize="14" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <!-- Shipping -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Shipping" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1" FontSize="14">
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="Text" Value="{Binding Shipping, StringFormat='${0:F2}'}" />
                                        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Shipping}" Value="0">
                                                <Setter Property="Text" Value="FREE" />
                                                <Setter Property="TextColor" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </Grid>
                        <!-- Divider -->
                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4" />
                        <!-- Total -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Total" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Column="1" Text="{Binding TotalAmount, StringFormat='${0:F2}'}"
                                   FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </Grid>
                    </StackLayout>
                </Frame>

                <!-- Payment Details -->
                <Label Text="Payment Details" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,10,0,0" />

                <!-- Mock Card Form -->
                <StackLayout Spacing="12">
                    <Frame CornerRadius="14" HasShadow="False" Padding="16,0"
                           HeightRequest="52" BackgroundColor="{StaticResource SecondaryBackground}"
                           BorderColor="Transparent">
                        <Entry Placeholder="Card Number (e.g. 4242...)"
                               PlaceholderColor="{StaticResource TextLight}"
                               TextColor="{StaticResource TextPrimary}"
                               Keyboard="Numeric" FontSize="15"
                               Text="{Binding CardNumber}"
                               VerticalOptions="Center" />
                    </Frame>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Frame Grid.Column="0" CornerRadius="14" HasShadow="False" Padding="16,0"
                               HeightRequest="52" BackgroundColor="{StaticResource SecondaryBackground}"
                               BorderColor="Transparent">
                            <Entry Placeholder="MM/YY"
                                   PlaceholderColor="{StaticResource TextLight}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="15"
                                   Text="{Binding ExpiryDate}"
                                   VerticalOptions="Center" />
                        </Frame>
                        <Frame Grid.Column="1" CornerRadius="14" HasShadow="False" Padding="16,0"
                               HeightRequest="52" BackgroundColor="{StaticResource SecondaryBackground}"
                               BorderColor="Transparent">
                            <Entry Placeholder="CVV"
                                   PlaceholderColor="{StaticResource TextLight}"
                                   TextColor="{StaticResource TextPrimary}"
                                   Keyboard="Numeric" FontSize="15"
                                   IsPassword="True"
                                   Text="{Binding Cvv}"
                                   VerticalOptions="Center" />
                        </Frame>
                    </Grid>
                </StackLayout>

                <!-- Loading Indicator for Payment Intent -->
                <StackLayout IsVisible="{Binding IsBusy}" HorizontalOptions="Center" Margin="0,10">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" />
                    <Label Text="Processing..." FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                </StackLayout>

                <Button Text="{Binding TotalAmount, StringFormat='Pay ${0:F2}'}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White" FontAttributes="Bold" FontSize="16"
                        CornerRadius="16" HeightRequest="56" Margin="0,20,0,0"
                        Command="{Binding ProcessPaymentCommand}" />
                
                <Label Text="🔒 Secure checkout provided by Stripe" FontSize="12" 
                       TextColor="{StaticResource TextLight}" HorizontalOptions="Center" Margin="0,10,0,0" />

            </StackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
